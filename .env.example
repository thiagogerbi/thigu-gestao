# Thigu Gestão — variáveis de ambiente
# Copie para .env.local e preencha com os dados do SEU projeto Supabase de desenvolvimento.
# A prévia (/previa) funciona sem nenhuma destas variáveis.

# URL do projeto (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon"/"publishable". Pode ir ao navegador: o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NÃO use a chave service_role neste projeto. Nenhuma parte do código precisa dela,
# e ela nunca deve ter o prefixo NEXT_PUBLIC_.
